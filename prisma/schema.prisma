generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------
enum UserRole {
  USER          // Retail Trader / Client
  CREATOR       // Strategy Builder / Publisher
  ADMIN         // Operations / Risk Admin
  SUPER_ADMIN   // Full Platform Access
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum BrokerCode {
  ZERODHA
  UPSTOX
  ANGELONE
  DHAN
  FYERS
}

enum BrokerStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

enum AuditAction {
  USER_LOGIN
  USER_REGISTER
  USER_STATUS_CHANGE
  BROKER_CONNECT
  BROKER_DISCONNECT
  STRATEGY_CREATE
  ORDER_PLACED
  KILL_SWITCH_TRIGGERED
}

// -------------------------------------------------------------
// 1. USERS TABLE
// -------------------------------------------------------------
model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  phone            String?         @unique
  passwordHash     String          @map("password_hash")
  role             UserRole        @default(USER)
  status           UserStatus      @default(ACTIVE)
  isEmailVerified  Boolean         @default(false) @map("is_email_verified")
  isPhoneVerified  Boolean         @default(false) @map("is_phone_verified")
  twoFactorEnabled Boolean         @default(false) @map("two_factor_enabled")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  sessions         UserSession[]
  brokerAccounts   BrokerAccount[]
  auditLogs        AuditLog[]

  @@map("users")
}

// -------------------------------------------------------------
// 2. USER SESSIONS TABLE (For JWT Refresh Tokens & Multi-device)
// -------------------------------------------------------------
model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relation with User
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// -------------------------------------------------------------
// 3. BROKER ACCOUNTS TABLE (Encrypted credentials at rest)
// -------------------------------------------------------------
model BrokerAccount {
  id                   String       @id @default(uuid())
  userId               String       @map("user_id")
  brokerCode           BrokerCode   @map("broker_code")
  accountRef           String       @map("account_ref") // Client ID (e.g. ZER1234, 458921)
  apiKeyEncrypted      String?      @map("api_key_encrypted")
  apiSecretEncrypted   String?      @map("api_secret_encrypted")
  accessTokenEncrypted String?      @map("access_token_encrypted")
  tokenExpiresAt       DateTime?    @map("token_expires_at")
  status               BrokerStatus @default(DISCONNECTED)
  lastSyncAt           DateTime?    @map("last_sync_at")
  errorMessage         String?      @map("error_message")
  metadata             Json?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relation with User
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brokerCode, accountRef])
  @@index([userId])
  @@map("broker_accounts")
}

// -------------------------------------------------------------
// 4. AUDIT LOGS TABLE (Immutable Trail for Operations & Safety)
// -------------------------------------------------------------
model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?     @map("actor_id")
  role       UserRole?
  action     AuditAction
  entity     String      // e.g. 'USER', 'BROKER_ACCOUNT', 'ORDER'
  entityId   String?     @map("entity_id")
  details    Json?       // Snapshot / request metadata
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Relation
  user       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}